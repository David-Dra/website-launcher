#!/bin/bash
# One website per container. Installed by build-template.sh as /usr/local/sbin/site; run as root, usually via
# `pct exec <ctid> -- site …` from the Proxmox host (pve-site.sh does that for you).
#
#   site up <repo-url> [--branch main] [--host www.example.org] [--subdir dir] [--poll 2min|off] [--lan]
#   site update [--force]        new commit on the branch? build a release, health-check it, switch to it
#   site status                  what is live, last deploy result
#   site rollback [<release>]    back to the previous (or a named) release, no rebuild
#   site logs                    deploy log + app log
#   site secret set NAME         value on stdin   (app env: systemd EnvironmentFile / docker --env-file)
#   site secret list | rm NAME
#   site tunnel                  Cloudflare tunnel token on stdin; `site tunnel off` stops it
#   site github-token            GitHub token on stdin (read-only fine-grained token, for private repos)
#   site hub <url>               hub token on stdin: deploy results go to that hub (optional)
#   site down                    stop app, tunnel and auto-update; files stay
#
# Secrets only ever come in on stdin (argv shows up in `ps`), trailing \r is stripped (values piped from Windows).
# Layout: /etc/site (config + secrets, root 0600), /srv/site/repo (git cache), /srv/site/releases/<utc>-<sha>,
# /srv/site/current -> live release, /srv/site/data (kept across releases, for the app), /var/lib/site (state),
# /var/log/site/deploy.log.
set -euo pipefail

ETC=/etc/site
SRV=/srv/site
STATE=/var/lib/site
LIB=/usr/local/lib/site
LOG=/var/log/site/deploy.log
KEEP=3
BUILD_TIMEOUT=20m
SITE_PATH=/var/lib/site/home/bin:/usr/local/bin:/usr/bin:/bin

die() { echo "site: $*" >&2; exit 1; }
log() { echo "$(date -u +%FT%TZ) $*" | tee -a "$LOG" >&2; }
[[ $EUID -eq 0 ]] || die "run as root"
mkdir -p "$ETC" "$SRV/releases" "$SRV/data" "$STATE" "$(dirname "$LOG")"
chmod 700 "$ETC"
chown site:site "$SRV/data"

stdin_value() {  # one line from stdin, without \r and surrounding blanks
  local v
  IFS= read -r v || true
  v=${v//$'\r'/}
  v=$(sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' <<<"$v")
  [[ -n "$v" ]] || die "expected the value on stdin"
  printf '%s' "$v"
}

set_kv() {  # set_kv <file> <KEY> <value>: replace or append KEY=value, file stays 0600
  local f=$1 k=$2 v=$3 tmp
  touch "$f"; chmod 600 "$f"
  tmp=$(mktemp "$f.XXXX")
  grep -v "^$k=" "$f" >"$tmp" || true
  printf '%s=%s\n' "$k" "$v" >>"$tmp"
  chmod 600 "$tmp"; mv "$tmp" "$f"
}

load() { if [[ -f "$1" ]]; then . "$1"; fi; }
load "$ETC/site.env"
load "$STATE/live.env"
load "$STATE/status.env"

as_site() {  # as_site <dir> <command>: a build step as the unprivileged site user, without any secrets in its env
  (cd "$1" && timeout "$BUILD_TIMEOUT" runuser -u site -- env -i PATH="$SITE_PATH" HOME=/var/lib/site/home \
     COREPACK_ENABLE_DOWNLOAD_PROMPT=0 CI=true bash -c "$2")
}

mem_mb() { awk '/MemTotal/{print int($2/1024)}' /proc/meminfo; }

dc() {  # docker compose (plugin) or docker-compose (Debian package)
  if docker compose version >/dev/null 2>&1; then docker compose "$@"; else docker-compose "$@"; fi
}

need_docker() {
  systemctl is-enabled -q docker 2>/dev/null || systemctl enable --now docker >/dev/null 2>&1 || true
  docker info >/dev/null 2>&1 || die "docker does not run. On the Proxmox host: pct set <ctid> --features nesting=1,keyctl=1 && pct reboot <ctid>"
}

notify() {  # notify ok|failed <message>: to the hub, if `site hub` was set up; never fails the deploy
  local status=$1 msg=$2
  [[ -f "$ETC/hub.env" ]] || return 0
  ( . "$ETC/hub.env"
    body=$(node -e 'const a=process.argv; console.log(JSON.stringify({site:a[1],status:a[2],commit:a[3],message:a[4].slice(0,400),url:a[5]}))' \
           "$(hostname)" "$status" "${COMMIT:-}" "$msg" "${SITE_HOST:+https://$SITE_HOST}")
    curl -fsS -m 10 -o /dev/null -H "Content-Type: application/json" -H @<(printf 'Authorization: Bearer %s\n' "$HUB_TOKEN") \
         -d "$body" "$HUB_URL/api/sites/event" ) || log "hub notification failed (ignored)"
}

write_status() {  # write_status ok|failed <commit> <message>
  cat >"$STATE/status.env" <<EOF
LAST_RESULT=$1
LAST_COMMIT=$2
LAST_AT=$(date -u +%FT%TZ)
LAST_MESSAGE=$(printf '%q' "${3:0:300}")
EOF
}

# --- Caddy -----------------------------------------------------------------------------------------------------------
caddy_write() {  # caddy_write static <spa> | proxy <port> | none
  local bind=127.0.0.1 body
  [[ "${SITE_LAN:-no}" == yes ]] && bind=0.0.0.0
  case $1 in
    static) body="	root * $SRV/current/.site-www"
            [[ "$2" == true ]] && body+=$'\n'"	try_files {path} {path}/ /index.html"
            body+=$'\n'"	file_server" ;;
    proxy) body="	reverse_proxy 127.0.0.1:$2" ;;
    none) body="	respond \"No site deployed yet.\" 200" ;;
  esac
  cat >/etc/caddy/Caddyfile.new <<EOF
# Written by /usr/local/sbin/site — edits are overwritten on the next deploy.
{
	admin localhost:2019
	auto_https off
}
http://:80 {
	bind $bind
	encode zstd gzip
	header -Server
	@hidden path /.git /.git/* /.env* /site.toml /.site-*
	respond @hidden 404
$body
}
EOF
  caddy validate --adapter caddyfile --config /etc/caddy/Caddyfile.new >/dev/null 2>&1 || { rm -f /etc/caddy/Caddyfile.new; return 1; }
  mv /etc/caddy/Caddyfile.new /etc/caddy/Caddyfile
  systemctl reload caddy 2>/dev/null || systemctl restart caddy
}

healthy() {  # healthy <port> <path>: up to 60 s for a 2xx/3xx answer
  local i
  for i in $(seq 30); do
    curl -fsS -o /dev/null -m 5 "http://127.0.0.1:$1$2" 2>/dev/null && return 0
    sleep 2
  done
  return 1
}

# --- runtimes --------------------------------------------------------------------------------------------------------
stop_runtime() {  # stop_runtime <type> <kind> <port> <release dir>
  case $1/$2 in
    node/*) systemctl disable --now "site-app@$3" >/dev/null 2>&1 || true ;;
    docker/dockerfile) docker rm -f "site-$3" >/dev/null 2>&1 || true ;;
    docker/compose) if [[ -d "$4" ]]; then (cd "$4" && dc -p site down --remove-orphans >/dev/null 2>&1) || true; fi ;;
  esac
}

other_port() { if [[ "${LIVE_PORT:-}" == "$1" ]]; then echo "$2"; else echo "$1"; fi; }

prepare() {  # prepare <release dir>: detect + build as user site; writes <rel>/.site-detect
  local rel=$1 d
  bash "$LIB/detect.sh" "$rel" >"$rel/.site-detect"
  . "$rel/.site-detect"
  echo "detected: type=$type kind=$kind${build:+ build=\"$build\"}${root:+ root=$root}${start:+ start=\"$start\"}"
  if [[ $type == docker ]]; then
    (( $(mem_mb) >= 900 )) || { echo "docker sites need ≥1024 MB RAM. On the Proxmox host: pct set <ctid> --memory 1024 --swap 1024"; return 1; }
    return 0
  fi
  if [[ -n "$build" ]] && (( $(mem_mb) < 900 )); then
    echo "warning: $(mem_mb) MB RAM; if the build runs out of memory: pct set <ctid> --memory 1024 --swap 1024"
  fi
  if [[ -f "$rel/package.json" ]]; then
    case $pm in
      pnpm) as_site "$rel" "mkdir -p ~/bin && corepack enable --install-directory ~/bin && pnpm install --frozen-lockfile" ;;
      yarn) as_site "$rel" "mkdir -p ~/bin && corepack enable --install-directory ~/bin && { yarn install --immutable || yarn install --frozen-lockfile; }" ;;
      *) if [[ -f "$rel/package-lock.json" ]]; then as_site "$rel" "npm ci --include=dev --no-audit --no-fund"
         else as_site "$rel" "npm install --include=dev --no-audit --no-fund"; fi ;;
    esac
  fi
  if [[ -n "$build" ]]; then as_site "$rel" "NODE_ENV=production $build"; fi
  if [[ $type == static ]]; then
    if [[ -z "$root" ]]; then
      for d in dist build out _site public .; do if [[ -f "$rel/$d/index.html" ]]; then root=$d; break; fi; done
      [[ -n "$root" ]] || { echo "build finished but there is no index.html in dist/ build/ out/ _site/ public/; set root in site.toml"; return 1; }
      sed -i "s|^root=.*|root='$root'|" "$rel/.site-detect"
    fi
    [[ -f "$rel/$root/index.html" ]] || { echo "no index.html in $root/"; return 1; }
    ln -sfn "$rel/$root" "$rel/.site-www"
  fi
  if [[ $type == node ]]; then printf 'SITE_START=%s\n' "$start" >"$rel/.site-start"; fi
}

switch_current() { ln -sfn "$1" "$SRV/current.new" && mv -T "$SRV/current.new" "$SRV/current"; }

activate() {  # activate <release dir>: start it next to the live one, health-check, switch traffic, stop the old one
  local rel=$1 prev=${LIVE_RELEASE:-} app_port envf=()
  . "$rel/.site-detect"
  app_port=$port  # what the app/container listens on; $port becomes what Caddy proxies to
  [[ -s "$ETC/secrets.env" ]] && envf=(--env-file "$ETC/secrets.env")
  case $type in
    static)
      switch_current "$rel"
      caddy_write static "$spa" || { echo "caddy config invalid"; [[ -z "$prev" ]] || switch_current "$prev"; return 1; }
      if ! healthy 80 "$health"; then
        if [[ -n "$prev" ]]; then switch_current "$prev"; . "$prev/.site-detect"; caddy_write static "$spa" || true; fi
        echo "health check $health failed"; return 1
      fi
      port=80 ;;
    node)
      port=$(other_port 3001 3002)
      ln -sfn "$rel" "$SRV/slot-$port"
      { cat "$rel/.site-start"; echo "PORT=$port"; } >"$ETC/app-$port.env"; chmod 600 "$ETC/app-$port.env"
      systemctl restart "site-app@$port"
      if ! healthy "$port" "$health"; then
        journalctl -u "site-app@$port" -n 15 --no-pager || true
        systemctl disable --now "site-app@$port" >/dev/null 2>&1 || true
        echo "app did not answer on $health within 60 s (it must listen on \$PORT)"; return 1
      fi
      systemctl enable "site-app@$port" >/dev/null 2>&1
      caddy_write proxy "$port" ;;
    docker)
      need_docker
      if [[ $kind == dockerfile ]]; then
        local tag="site:$(basename "$rel")"
        port=$(other_port 8081 8082)
        docker image inspect "$tag" >/dev/null 2>&1 || docker build -q -t "$tag" "$rel" >/dev/null
        docker rm -f "site-$port" >/dev/null 2>&1 || true
        docker run -d --name "site-$port" --restart unless-stopped "${envf[@]}" -v "$SRV/data:/data" \
               -p "127.0.0.1:$port:$app_port" "$tag" >/dev/null
        if ! healthy "$port" "$health"; then
          docker logs --tail 15 "site-$port" 2>&1 || true; docker rm -f "site-$port" >/dev/null 2>&1 || true
          echo "container did not answer on $health within 60 s (EXPOSE or site.toml port = what it listens on)"; return 1
        fi
      else
        port=$app_port
        (cd "$rel" && dc -p site "${envf[@]}" build -q && dc -p site "${envf[@]}" up -d --remove-orphans) >/dev/null
        if ! healthy "$port" "$health"; then
          (cd "$rel" && dc -p site logs --tail 15) 2>&1 || true
          if [[ -n "$prev" && "${LIVE_KIND:-}" == compose ]]; then (cd "$prev" && dc -p site "${envf[@]}" up -d --remove-orphans >/dev/null 2>&1) || true; fi
          echo "compose app did not answer on 127.0.0.1:$port$health within 60 s (publish it as 127.0.0.1:$port, or set port in site.toml)"; return 1
        fi
      fi
      caddy_write proxy "$port" ;;
  esac
  switch_current "$rel"
  # Stop what ran before, unless it was the same compose project (just replaced) or the same static Caddy
  if [[ -n "${LIVE_TYPE:-}" && "${LIVE_PORT:-}" != "$port" ]] && ! [[ "$LIVE_KIND" == compose && "$kind" == compose ]]; then
    stop_runtime "$LIVE_TYPE" "$LIVE_KIND" "$LIVE_PORT" "$prev"
  fi
  cat >"$STATE/live.env" <<EOF
LIVE_RELEASE=$rel
LIVE_TYPE=$type
LIVE_KIND=$kind
LIVE_PORT=$port
LIVE_COMMIT=$(cat "$rel/.site-commit")
EOF
}

prune() {  # keep the newest $KEEP releases plus the live one
  local r live
  live=$(readlink -f "$SRV/current" || true)
  ls -1d "$SRV"/releases/*/ 2>/dev/null | sed 's:/$::' | sort -r | tail -n +$((KEEP + 1)) | while read -r r; do
    [[ "$r" == "$live" ]] && continue
    rm -rf "$r"
    if command -v docker >/dev/null; then docker image rm "site:$(basename "$r")" >/dev/null 2>&1 || true; fi
  done
}

# --- commands --------------------------------------------------------------------------------------------------------
cmd_update() {
  local force=no wait=no
  while (( $# )); do
    case $1 in
      --force) force=yes ;;
      --wait) wait=yes ;;  # wait for a deploy that is running (site up), instead of skipping
      *) die "usage: site update [--force]" ;;
    esac
    shift
  done
  [[ -n "${SITE_REPO:-}" ]] || die "no site yet: site up <repo-url>"
  exec 9>/run/site.lock
  if [[ $wait == yes ]]; then
    flock -n 9 || { echo "a deploy is running, waiting for it to finish"; flock -w 1800 9 || die "it did not finish within 30 min"; }
  else
    flock -n 9 || { echo "a deploy is already running"; return 0; }
  fi

  COMMIT=$(git ls-remote "$SITE_REPO" "refs/heads/$SITE_BRANCH" 2>>"$LOG" | cut -f1)
  if [[ -z "$COMMIT" ]]; then
    log "cannot read branch $SITE_BRANCH of $SITE_REPO (private repo? site github-token)"
    if [[ "${LAST_MESSAGE:-}" != "cannot read the repo" ]]; then write_status failed "" "cannot read the repo"; notify failed "cannot read branch $SITE_BRANCH of the repo"; fi
    return 1
  fi
  if [[ $force == no && ( "$COMMIT" == "${LIVE_COMMIT:-}" || "$COMMIT" == "${LAST_COMMIT:-}" ) ]]; then
    return 0  # live already, or this commit failed before: wait for the next push (or --force)
  fi
  log "deploying ${COMMIT:0:7} from $SITE_REPO ($SITE_BRANCH)"

  if [[ ! -d "$SRV/repo/.git" ]]; then
    rm -rf "$SRV/repo"; git clone -q --depth 1 --branch "$SITE_BRANCH" "$SITE_REPO" "$SRV/repo"
  fi
  git -C "$SRV/repo" remote set-url origin "$SITE_REPO"
  git -C "$SRV/repo" fetch -q --depth 1 origin "$SITE_BRANCH"
  git -C "$SRV/repo" reset -q --hard FETCH_HEAD
  git -C "$SRV/repo" clean -qfdx
  if grep -qs 'filter=lfs' "$SRV/repo/.gitattributes"; then git -C "$SRV/repo" lfs pull 2>>"$LOG" || log "git lfs pull failed"; fi
  COMMIT=$(git -C "$SRV/repo" rev-parse HEAD)

  local rel="$SRV/releases/$(date -u +%Y%m%d%H%M%S)-${COMMIT:0:7}" src="$SRV/repo/${SITE_SUBDIR:-}" out why
  if [[ ! -d "$src" ]]; then write_status failed "$COMMIT" "subdir $SITE_SUBDIR not in repo"; notify failed "subdir $SITE_SUBDIR not in the repo"; return 1; fi
  mkdir -p "$rel"
  rsync -a --exclude .git "$src/" "$rel/"
  echo "$COMMIT" >"$rel/.site-commit"
  chown -R site:site "$rel"

  # Own processes: inside an `if`, bash ignores set -e, and any failed build step must stop the deploy
  if out=$("$0" _prepare "$rel" 2>&1 | tee -a "$LOG"; exit "${PIPESTATUS[0]}") &&
     out=$("$0" _activate "$rel" 2>&1 | tee -a "$LOG"; exit "${PIPESTATUS[0]}"); then
    log "live: ${COMMIT:0:7} ($rel)"
    write_status ok "$COMMIT" "live"
    notify ok "live"
    prune
  else
    why=$(grep -v '^[[:space:]]*$' <<<"$out" | tail -3 | tr '\n' ' ')
    log "FAILED ${COMMIT:0:7}: $why — the previous release stays live"
    write_status failed "$COMMIT" "$why"
    notify failed "$why"
    rm -rf "$rel"
    return 1
  fi
}

cmd_up() {
  local repo=${1:-}; shift || true
  [[ "$repo" =~ ^(https://github\.com/|git@github\.com:)[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] ||
    die "usage: site up https://github.com/<user>/<repo> [--branch b] [--host h] [--subdir d] [--poll 2min|off] [--lan]"
  repo=${repo/git@github.com:/https://github.com/}; repo=${repo%.git}.git
  local branch=main host="" subdir="" poll=2min lan=no
  while (( $# )); do
    case $1 in
      --branch) branch=$2; shift 2 ;;
      --host) host=$2; shift 2 ;;
      --subdir) subdir=$2; shift 2 ;;
      --poll) poll=$2; shift 2 ;;
      --lan) lan=yes; shift ;;
      *) die "unknown option $1" ;;
    esac
  done
  [[ "$branch" =~ ^[A-Za-z0-9._/-]+$ && "$subdir" =~ ^[A-Za-z0-9._/-]*$ && "$subdir" != *..* && "$poll" =~ ^([0-9]+(s|min|h)|off)$ ]] ||
    die "bad --branch, --subdir or --poll"
  [[ -z "$host" || "$host" =~ ^[a-z0-9.-]+$ ]] || die "bad --host"
  if [[ "${SITE_REPO:-}" != "$repo" || "${SITE_BRANCH:-}" != "$branch" ]]; then rm -rf "$SRV/repo"; fi
  cat >"$ETC/site.env" <<EOF
SITE_REPO=$repo
SITE_BRANCH=$branch
SITE_HOST=$host
SITE_SUBDIR=$subdir
SITE_POLL=$poll
SITE_LAN=$lan
EOF
  chmod 600 "$ETC/site.env"
  . "$ETC/site.env"
  # The timer starts only after the first deploy: enabled earlier, it fires at once (OnBootSec has long passed) and
  # its own `site update` takes the deploy lock from this one
  systemctl disable --now site-update.timer >/dev/null 2>&1 || true
  if [[ $poll != off ]]; then
    mkdir -p /etc/systemd/system/site-update.timer.d
    # the empty OnUnitActiveSec= first replaces the unit's default instead of adding a second interval
    printf '[Timer]\nOnUnitActiveSec=\nOnUnitActiveSec=%s\n' "$poll" >/etc/systemd/system/site-update.timer.d/interval.conf
    systemctl daemon-reload
  fi
  [[ -n "${LIVE_TYPE:-}" ]] || caddy_write none
  local rc=0
  LAST_COMMIT="" cmd_update --force --wait || rc=$?
  exec 9>&-  # release the deploy lock before the timer can run
  if [[ $poll != off ]]; then systemctl enable --now site-update.timer >/dev/null 2>&1; fi
  cmd_status
  return "$rc"
}

cmd_status() {
  load "$STATE/live.env"; load "$STATE/status.env"
  local live=${LIVE_COMMIT:-} last=${LAST_COMMIT:-}  # set -u: ${UNSET:0:7} is an error, not empty
  echo "repo:     ${SITE_REPO:-none} (${SITE_BRANCH:-})${SITE_SUBDIR:+ subdir $SITE_SUBDIR}"
  echo "url:      ${SITE_HOST:+https://$SITE_HOST}  (tunnel: $(systemctl is-active cloudflared-site 2>/dev/null || true))"
  echo "live:     ${live:0:7}${LIVE_TYPE:-nothing}${LIVE_KIND:+/$LIVE_KIND} ${LIVE_PORT:+port $LIVE_PORT} ${LIVE_RELEASE:-}"
  echo "last:     ${LAST_RESULT:-never} ${last:0:7}${LAST_AT:-} — ${LAST_MESSAGE:-}"
  echo "updates:  every ${SITE_POLL:-?} ($(systemctl is-active site-update.timer 2>/dev/null || true))"
  echo "releases: $(ls -1 "$SRV/releases" 2>/dev/null | tr '\n' ' ')"
}

cmd_rollback() {
  exec 9>/run/site.lock; flock -n 9 || die "a deploy is running"
  local target=${1:-} live
  live=$(readlink -f "$SRV/current" || true)
  if [[ -z "$target" ]]; then
    target=$(ls -1d "$SRV"/releases/*/ | sed 's:/$::' | sort -r | awk -v l="$live" 'f{print;exit} $0==l{f=1}')
    [[ -n "$target" ]] || die "no older release kept"
  else
    target="$SRV/releases/$(basename "$target")"
  fi
  [[ -f "$target/.site-detect" ]] || die "not a release: $target"
  COMMIT=$(cat "$target/.site-commit")
  "$0" _activate "$target" || die "rollback failed, see: site logs"
  # The branch head counts as handled, so the next poll does not redeploy the commit just rolled away from
  write_status ok "$(git -C "$SRV/repo" rev-parse HEAD 2>/dev/null || echo "$COMMIT")" "rolled back to ${COMMIT:0:7}; the next push deploys again"
  log "rolled back to $target"
  cmd_status
}

cmd_secret() {
  local f="$ETC/secrets.env"
  case ${1:-} in
    set) [[ "${2:-}" =~ ^[A-Z_][A-Z0-9_]*$ ]] || die "usage: site secret set NAME  (value on stdin)"
         set_kv "$f" "$2" "$(stdin_value)"
         echo "$2 saved. Takes effect on the next deploy: site update --force" ;;
    rm) [[ "${2:-}" =~ ^[A-Z_][A-Z0-9_]*$ ]] || die "usage: site secret rm NAME"; touch "$f"; sed -i "/^$2=/d" "$f"; echo "$2 removed" ;;
    list) if [[ -f "$f" ]]; then cut -d= -f1 "$f"; fi ;;
    *) die "usage: site secret set NAME | list | rm NAME" ;;
  esac
}

cmd_tunnel() {
  if [[ "${1:-}" == off ]]; then systemctl disable --now cloudflared-site; return; fi
  local t; t=$(stdin_value)
  [[ "$t" =~ ^[A-Za-z0-9+/=_-]{40,}$ ]] || die "that does not look like a tunnel token"
  set_kv "$ETC/cloudflared.env" TUNNEL_TOKEN "$t"
  systemctl enable cloudflared-site >/dev/null 2>&1
  systemctl restart cloudflared-site
  sleep 3
  if systemctl is-active -q cloudflared-site; then echo "tunnel running"; else journalctl -u cloudflared-site -n 10 --no-pager; exit 1; fi
}

cmd_github_token() {
  local t; t=$(stdin_value)
  [[ "$t" =~ ^(github_pat_|ghp_)[A-Za-z0-9_]+$ ]] || die "expected a GitHub token (github_pat_… or ghp_…) on stdin"
  ( umask 077; printf 'https://x-access-token:%s@github.com\n' "$t" >"$ETC/git-credentials" )
  git config --system credential.helper "store --file $ETC/git-credentials"
  echo "GitHub token saved"
}

cmd_hub() {
  [[ "${1:-}" =~ ^https?://[A-Za-z0-9.:-]+$ ]] || die "usage: site hub http://192.0.2.70:8090   (token on stdin)"
  local t; t=$(stdin_value)
  ( umask 077; printf 'HUB_URL=%s\nHUB_TOKEN=%s\n' "$1" "$t" >"$ETC/hub.env" )
  echo "hub notifications on"
}

cmd_down() {
  systemctl disable --now site-update.timer cloudflared-site >/dev/null 2>&1 || true
  if [[ -n "${LIVE_TYPE:-}" ]]; then stop_runtime "$LIVE_TYPE" "$LIVE_KIND" "$LIVE_PORT" "${LIVE_RELEASE:-}"; fi
  rm -f "$STATE/live.env"
  caddy_write none || true
  echo "site stopped (files kept; site update --force starts it again)"
}

case ${1:-} in
  up) shift; cmd_up "$@" ;;
  update) shift; cmd_update "$@" ;;
  status) cmd_status ;;
  rollback) shift; cmd_rollback "$@" ;;
  logs) tail -n 40 "$LOG" 2>/dev/null || true
        if [[ "${LIVE_TYPE:-}" == node ]]; then journalctl -u "site-app@$LIVE_PORT" -n 20 --no-pager || true; fi ;;
  secret) shift; cmd_secret "$@" ;;
  tunnel) shift; cmd_tunnel "$@" ;;
  github-token) cmd_github_token ;;
  hub) shift; cmd_hub "$@" ;;
  down) cmd_down ;;
  firstboot) if [[ -n "${SITE_REPO:-}" && -z "${LIVE_TYPE:-}" ]]; then LAST_COMMIT="" cmd_update --force || true; fi ;;
  _prepare) prepare "$2" ;;
  _activate) activate "$2" ;;
  *) sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
