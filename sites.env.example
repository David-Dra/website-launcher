# Copy to /root/.config/pve-sites.env on the Proxmox host and `chmod 600` it. pve-site.sh reads it on every run;
# a variable already set in the environment wins over the file. Example values below are placeholders.

# --- required ---
# Sites are published as <name>.$DOMAIN (the zone must be on your Cloudflare account).
DOMAIN=example.org
# Id of the template CT built with ct/build-template.sh and turned into a template (`pct template <id>`).
TEMPLATE=111
# DNS server the site CTs use (your router or Pi-hole). It is the only LAN address they may reach on port 53.
DNS_IP=192.0.2.27
# Your LAN range. Site CTs may not reach anything in it, except DNS, the hub and their --allow-out targets.
LAN=192.0.2.0/24

# --- optional ---
# Tailnet range that is blocked as well (default: Tailscale's 100.64.0.0/10).
#TAILNET=100.64.0.0/10
# A hub that collects deploy results: http://ip:port. Leave empty for none (no firewall hole is opened then).
#HUB_URL=http://192.0.2.70:8090
#HUB_TOKEN=

# --- Cloudflare (required for new / publish / unpublish / list) ---
# API token with Account > Cloudflare Tunnel > Edit and Zone > DNS > Edit, for your zone only.
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_ZONE_ID=

# --- GitHub (only for private repos) ---
# Fine-grained token, only the website repos, Contents: read-only, with an expiry.
#GITHUB_TOKEN=
